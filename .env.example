# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# DOKU Payment Gateway (Model Platform + Sub Account). Nilai asli hanya di env server / secret manager.
DOKU_ENV=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# Path Notification URL yang didaftarkan di dashboard DOKU (dipakai untuk verifikasi signature webhook)
DOKU_NOTIFICATION_PATH=/api/webhook/doku
# Opsional: default true di production, false di sandbox
# DOKU_REQUIRE_SUB_ACCOUNT=false
# Opsional: batas waktu bayar (menit) & estimasi MDR (%)
# DOKU_PAYMENT_DUE_MINUTES=15
# DOKU_ESTIMATED_MDR_PERCENT=0.7

# Origin publik aplikasi untuk callback URL pembayaran, mis. https://app.menuin.id
APP_BASE_URL=
# Secret untuk endpoint cron rekonsiliasi (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
