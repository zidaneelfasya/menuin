# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# DOKU Payment Gateway (Model Platform + Sub Account). Nilai asli hanya di env server / secret manager.
DOKU_ENV=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# Path Notification URL yang didaftarkan di dashboard DOKU (dipakai untuk verifikasi signature webhook)
DOKU_NOTIFICATION_PATH=/api/webhook/doku
# Opsional: default true di production, false di sandbox
# DOKU_REQUIRE_SUB_ACCOUNT=false
# Opsional: batas waktu bayar (menit) & estimasi MDR (%)
# DOKU_PAYMENT_DUE_MINUTES=15
# DOKU_ESTIMATED_MDR_PERCENT=0.7

# DOKU SNAP — QRIS dinamis di POS (opsional; tanpa ini opsi QRIS Dinamis dinonaktifkan)
# Private key RSA milik Menuin (PEM, boleh satu baris dengan \n). Public key-nya diunggah ke dashboard DOKU.
DOKU_PRIVATE_KEY=
# Public key MILIK DOKU (PEM) dari dashboard DOKU — bukan public key Menuin.
DOKU_PUBLIC_KEY=
# DOKU_SNAP_CHANNEL_ID=95221
# Merchant/terminal QRIS default (sandbox). Di production tiap outlet memakai tenants.doku_qris_*.
DOKU_QRIS_MERCHANT_ID=
DOKU_QRIS_TERMINAL_ID=
# DOKU_QRIS_POSTAL_CODE=
# DOKU_QRIS_VALIDITY_MINUTES=10

# Origin publik aplikasi untuk callback URL pembayaran, mis. https://app.menuin.id
APP_BASE_URL=
# Secret untuk endpoint cron rekonsiliasi (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
