# Supabase Public & Anon
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Database (PostgreSQL / Supabase Transaction/Session Pooler)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# App URL (Production domain, e.g., https://app.menuin.id)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Supabase Service Role Key (Required for server-side administrative actions & user management)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret (Used for Mobile & POS Token Signing)
JWT_SECRET=your-jwt-secret-generate-with-openssl-rand-hex-32

# Resend Email Service (Optional: for sending tenant invites & notifications)
RESEND_API_KEY=re_your_resend_api_key

# Midtrans Payment Gateway (Optional: for subscription & online checkout)
MIDTRANS_MERCHANT_ID=your-midtrans-merchant-id
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_SERVER_KEY=your-midtrans-server-key
